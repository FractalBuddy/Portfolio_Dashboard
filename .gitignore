# Generated by the workflow and published to the `data` branch -- never commit to main.
data.json
meta.json
prev.json

# Personal exports / backups must never land in a public repo.
*backup*.json
portfolio-backup*.json
*export*
*.csv
*.xlsx
*.zip

# Secrets and keys (.env.example is the only allowed .env file).
*.env
.env*
!.env.example
*.pem
*.key

# The dashboard itself is a private, personal file (it embeds API keys and seed data).
*.html

# Python / tools
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
